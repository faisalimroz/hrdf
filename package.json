{
  "name": "hdfd-server",
  "version": "1.0.0",
  "description": "Backend API for Hdfd Foundation (Human Development Forum Bangladesh)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seeds/siteSettingSeed.js",
    "seed:children": "node src/seeds/childSeed.js",
    "seed:all": "node src/seeds/siteSettingSeed.js && node src/seeds/childSeed.js && node src/seeds/contentSeed.js && node src/seeds/adminSeed.js"
  },
  "keywords": [
    "hdfd",
    "jaago-foundation",
    "charity",
    "donation",
    "sponsorship",
    "mern",
    "express",
    "mongodb"
  ],
  "author": "Hdfd Foundation Tech Team",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.7",
    "morgan": "^1.12.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "resend": "^4.8.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
